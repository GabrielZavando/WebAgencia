---
import MainLayout from '../layouts/MainLayout.astro';
import LoginForm from '../components/auth/LoginForm';
import logo from '../assets/img/logo-medium.png';
---

<MainLayout title="Iniciar sesión | Agencia Digital" hideHeader hideFooter forcedTheme="dark">
  <!-- Logo en esquina superior izquierda -->
  <div class="login-logo fade-in">
    <img src={logo.src} alt="Agencia Digital Logo" width="64" height="64" />
  </div>

  <!-- Página de login con fondo tecnológico -->
  <div class="login-page">
    <!-- Fondo tecnológico con CSS avanzado -->
    <div class="login-background">
      <div class="login-background__gradient"></div>
      <div class="login-background__grid"></div>
      <div class="login-background__overlay"></div>
    </div>

    <!-- Card de login centrada -->
    <div class="login-card fade-in">
      <div class="login-card__header">
        <h1 class="login-card__title">Bienvenido</h1>
        <p class="login-card__subtitle">Ingresa a tu panel de control</p>
      </div>

      <LoginForm client:load />

      <div class="login-card__footer">
        <p class="login-card__copyright">© 2026 Agencia Digital. Todos los derechos reservados.</p>
      </div>
    </div>

    <!-- Footer de página -->
    <footer class="login-footer fade-in">
      <p class="login-footer__text">
        © 2026 Gabriel Zavando. Todos los derechos reservados.
      </p>
      <p class="login-footer__credit">
        Desarrollado por: <span class="login-footer__link">Gabriel Zavando</span>
      </p>
    </footer>
  </div>
</MainLayout>

<style>
  /* =========================
     LOGIN PAGE - FONDO TECNOLÓGICO
     ========================= */
  
  .login-page {
    position: relative;
    min-height: 100vh;
    width: 100%;
    overflow: hidden;
    background: #0a0a1a;
  }

  /* Fondo tecnológico con CSS avanzado */
  .login-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
    overflow: hidden;
  }

  /* Gradiente base azul/violeta */
  .login-background__gradient {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(ellipse at 20% 30%, rgba(166, 0, 255, 0.15) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 70%, rgba(0, 255, 224, 0.1) 0%, transparent 50%),
      radial-gradient(ellipse at 50% 50%, rgba(29, 0, 51, 0.8) 0%, rgba(10, 10, 26, 1) 100%);
  }

  /* Patrón de grid tecnológico */
  .login-background__grid {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
      linear-gradient(rgba(166, 0, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(166, 0, 255, 0.03) 1px, transparent 1px);
    background-size: 50px 50px;
    animation: grid-move 20s linear infinite;
  }

  @keyframes grid-move {
    0% { transform: translate(0, 0); }
    100% { transform: translate(50px, 50px); }
  }

  /* Overlay para profundidad */
  .login-background__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 30% 40%, rgba(166, 0, 255, 0.08) 0%, transparent 40%),
      radial-gradient(circle at 70% 60%, rgba(0, 255, 224, 0.05) 0%, transparent 40%);
    backdrop-filter: blur(2px);
  }

  /* Logo en esquina superior */
  .login-logo {
    position: fixed;
    top: 1.5rem;
    left: 1.5rem;
    z-index: 100;
    animation: fade-in 0.6s ease-out;
  }

  .login-logo img {
    width: 4rem;
    height: 4rem;
    object-fit: contain;
    filter: drop-shadow(0 0 10px rgba(166, 0, 255, 0.3));
  }

  /* =========================
     LOGIN CARD
     ========================= */
  
  .login-card {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 450px;
    margin: 0 auto;
    padding: 2.5rem;
    background: rgba(30, 41, 59, 0.7);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    box-shadow: 
      0 25px 50px -12px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    animation: fade-in 0.8s ease-out;
  }

  .login-card__header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .login-card__title {
    font-size: 2rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.5rem 0;
    font-family: var(--font-headings);
    letter-spacing: -0.025em;
  }

  .login-card__subtitle {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
    font-weight: 400;
  }

  .login-card__footer {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
  }

  .login-card__copyright {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.4);
    margin: 0;
  }

  /* =========================
     LOGIN FOOTER
     ========================= */
  
  .login-footer {
    position: relative;
    z-index: 10;
    text-align: center;
    padding: 2rem 1rem;
    margin-top: 2rem;
    animation: fade-in 1s ease-out;
  }

  .login-footer__text {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 0.5rem 0;
  }

  .login-footer__credit {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
  }

  .login-footer__link {
    color: #00FFE0;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s;
  }

  .login-footer__link:hover {
    color: #FF0080;
  }

  /* =========================
     RESPONSIVE
     ========================= */
  
  @media (max-width: 767px) {
    .login-logo {
      top: 1rem;
      left: 1rem;
    }

    .login-logo img {
      width: 3rem;
      height: 3rem;
    }

    .login-card {
      margin: 2rem 1rem;
      padding: 2rem 1.5rem;
    }

    .login-card__title {
      font-size: 1.75rem;
    }

    .login-footer {
      padding: 1.5rem 1rem;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .login-card {
      max-width: 400px;
    }
  }

  @media (min-width: 1024px) {
    .login-card {
      max-width: 450px;
    }
  }
</style>