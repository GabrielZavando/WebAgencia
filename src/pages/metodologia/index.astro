---
import MainLayout from '../../layouts/MainLayout.astro';
import Banner from '../../components/landing/Banner.astro';
import GeneralVision from '../../components/metodologia/GeneralVision.astro';
import DetailedPipeline from '../../components/metodologia/DetailedPipeline.astro';
import ChangeManagement from '../../components/metodologia/ChangeManagement.astro';
import MaturitySpiral from '../../components/metodologia/MaturitySpiral.astro';

import bannerMetodologiaImg from '../../assets/img/metodologia-banner.webp';
---

<MainLayout 
  title="Metodología CTP: Transformación Digital con Soberanía | Gabriel Zavando" 
  description="Conoce el Método CTP: Diagnóstico → Cerebro → Músculo → Soberanía. Estrategia antes que código. Acompañamiento permanente. Diagnóstico gratis."
  ogTitle="Metodología CTP: Estrategia antes que código"
  ogDescription="4 fases probadas para transformar tu negocio con tecnología soberana."
  ogImage={bannerMetodologiaImg.src}
>
  <Banner image={bannerMetodologiaImg} size="half" align="center">
      <h1 class="banner__title fade-in">
        <span class="title-2xl">Metodología CTP</span>
        <span class="title-md">Ciclo de Transformación Progresiva</span>
      </h1>

      <div class="banner__actions fade-in fade-in-delay-2">
        <a href="https://calendly.com/gabrielzavando/30min" target="_blank" rel="noopener noreferrer" class="btn-cta">
          <span class="material-symbols-outlined">calendar_today</span> Agendar diagnóstico gratis
        </a>
      </div>
  </Banner>
  <main class="page-methodology">
    <GeneralVision />
    <DetailedPipeline />

    <ChangeManagement />
    <MaturitySpiral />

    <section class="pb-20 bg-surface">
      <div class="mx-auto w-full max-w-[1440px] px-4 text-center">
        <div class="detailed-pipeline__cta fade-in">
          <a href="https://calendly.com/gabrielzavando/30min" target="_blank" rel="noopener noreferrer" class="btn-cta btn-primary">
            <span class="material-symbols-outlined">calendar_today</span> 
            Comienza tu transformación 
            <span class="material-symbols-outlined ml-1">arrow_forward</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<style>
  /* GeneralVision styles */
  .methodology-vision {
    padding: var(--space-xl) 0;
    background-color: var(--color-body);
  }
  
  .methodology-vision__content {
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: 0 var(--padding-container);
  }
  
  .methodology-vision__header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }
  
  .methodology-pipeline {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
  }
  
  @media (min-width: 768px) {
    .methodology-pipeline {
      flex-direction: row;
      justify-content: center;
      flex-wrap: wrap;
    }
  }
  
  .pipeline-step {
    flex: 1;
    min-width: 200px;
    max-width: 280px;
  }
  
  .pipeline-step__card {
    padding: var(--space-lg);
    background: var(--color-surface);
    border-radius: 0.5rem;
    border: 2px solid var(--step-color, var(--color-primary));
    text-align: center;
    transition: transform var(--transition-normal) ease, box-shadow var(--transition-normal) ease;
  }
  
  .pipeline-step:hover .pipeline-step__card {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }
  
  .pipeline-step__phase {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--step-color, var(--color-primary));
    margin-bottom: var(--space-xs);
  }
  
  .pipeline-step__name {
    font-family: var(--font-headings);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
  }
  
  .pipeline-step__details {
    text-align: center;
    margin-top: var(--space-sm);
    padding: var(--space-sm);
    background: rgba(var(--step-color-rgb, var(--color-primary-rgb)), 0.08);
    border-radius: 0.25rem;
  }
  
  .pipeline-step__details .type {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    font-weight: 500;
  }
  
  .pipeline-step--green {
    --step-color: var(--color-success);
    --step-color-rgb: var(--color-success-rgb);
  }
  
  .pipeline-step--blue {
    --step-color: var(--color-primary);
    --step-color-rgb: var(--color-primary-rgb);
  }
  
  .pipeline-step--purple {
    --step-color: var(--color-secondary);
    --step-color-rgb: var(--color-secondary-rgb);
  }
  
  .pipeline-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    font-size: 2rem;
    margin: var(--space-sm) 0;
  }
  
  @media (min-width: 768px) {
    .pipeline-arrow {
      margin: 0 var(--space-md);
    }
  }
  
  .pipeline-arrow .material-symbols-outlined {
    font-size: 2.5rem;
  }
  
  .transversal-layer {
    text-align: center;
    margin-top: var(--space-xl);
  }
  
  .transversal-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-lg);
    background: rgba(var(--color-primary-rgb), 0.08);
    border: 1px solid var(--color-primary);
    border-radius: 0.5rem;
    color: var(--color-text);
    font-size: var(--text-sm);
  }
  
  .transversal-badge .material-symbols-outlined {
    color: var(--color-primary);
    font-size: 1.25rem;
  }
  
  .transversal-badge strong {
    font-weight: 600;
  }
</style>
