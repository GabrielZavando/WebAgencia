# =============================================================================
# WebAstro Monorepo — variables para docker-compose.yml (raíz)
# Copia este archivo como .env y completa los valores.
# NUNCA comitees el .env real.
# =============================================================================

# -----------------------------------------------------------------------------
# apps/web + apps/admin — variables de BUILD (Astro inyecta PUBLIC_* al compilar)
# -----------------------------------------------------------------------------
# URL pública de la API (sin /api/v1; los clientes lo añaden)
# En local con API contenedorizada: http://localhost:3000
# En staging/producción: https://api.tu-dominio.com
PUBLIC_API_URL=http://localhost:3000

# URL pública del sitio (canonical, sitemap)
PUBLIC_SITE_URL=http://localhost:4321

# Cloudflare Turnstile (key de test que siempre pasa)
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Google Tag Manager (opcional)
PUBLIC_GTM_ID=

# Firebase client (login del admin; en web ya no es requerido)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# apps/api — variables de RUNTIME
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:4321,http://localhost:4322

# Firebase Admin SDK (requerido)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
# Opcional: bucket de Storage (default: <PROJECT_ID>.appspot.com)
FIREBASE_STORAGE_BUCKET=

# Supabase PostgreSQL (requerido para Leads)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Webhook de revalidación del sitio público (Coolify)
REVALIDATION_WEBHOOK_TOKEN=
COOLIFY_REBUILD_WEBHOOK_URL=
