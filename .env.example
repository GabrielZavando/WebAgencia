# Variables de entorno para la Landing Page
# Copia este archivo como .env y completa los valores

# URL base del backend NestJS
# Producción:
PUBLIC_API_BASE_URL=https://nestjs-api-XXXXXXXXXX.us-central1.run.app
PUBLIC_API_URL=https://nestjs-api-XXXXXXXXXX.us-central1.run.app
# Desarrollo local:
# PUBLIC_API_BASE_URL=http://localhost:8080
# PUBLIC_API_URL=http://localhost:8080

# URL del sitio para SEO y Sitemap
PUBLIC_SITE_URL=https://tu-dominio.com

# Cloudflare Turnstile (Anti-Bot)
PUBLIC_TURNSTILE_SITE_KEY=


PUBLIC_GTM_ID=GTM-XXXXXXXX
