{
  "name": "@webastro/landing",
  "version": "1.4.2",
  "description": "Landing page con Astro para Agencia Digital Gabriel Zavando",
  "scripts": {
    "dev": "astro dev --open",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:ui": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "gen:api": "swagger-typescript-api generate -p ../Api/swagger.json -o ./src/api -n index.ts --axios"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^5.17.3",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^17.3.1",
    "jsdom": "^29.0.1",
    "sass": "^1.89.0",
    "swagger-typescript-api": "^13.7.2",
    "vitest": "^4.1.2"
  },
  "pnpm": {
    "allowBuilds": [
      "@parcel/watcher",
      "esbuild",
      "protobufjs",
      "sharp"
    ]
  }
}
