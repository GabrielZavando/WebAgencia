{
  "name": "webastro-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo SDD (Spec-Driven Development) con contexto Specboot compartido: API NestJS + Frontend Astro",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r --if-present lint",
    "dev:api": "pnpm -F @webastro/api start:dev",
    "dev:web": "pnpm -F @webastro/web dev",
    "validate": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.4.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@swc/core",
      "prisma",
      "@prisma/engines",
      "protobufjs",
      "@firebase/util"
    ]
  }
}
