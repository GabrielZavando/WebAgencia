# Root .gitignore for the WebAstro monorepo
node_modules/
dist/
coverage/
.astro/
cache/
*.log
.env
.env.local
.env.*.local

# Firebase service account keys
*-firebase.json

# OpenSpec tooling (regenerated by `openspec init`)
.opencode/node_modules/

# OS
.DS_Store
Thumbs.db

# Playwright artifacts (generated per app)
test-results/
playwright-report/

# TypeScript build artifacts
*.tsbuildinfo
