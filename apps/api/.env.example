# =============================================================================
# Líder Digital API - Variables de Entorno
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# CORS (Opcional)
# -----------------------------------------------------------------------------
# Origen permitido para el frontend (separar múltiples con coma)
# La API usa el prefijo /api/v1 para todos los endpoints
CORS_ORIGIN=http://localhost:4321

# -----------------------------------------------------------------------------
# Firebase Admin SDK (Requerido)
# -----------------------------------------------------------------------------
# Obtener estas credenciales desde la consola de Firebase:
# Firebase Console > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada

FIREBASE_PROJECT_ID=api-web-agencia
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@api-web-agencia.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# Supabase (Requerido para producción)
# -----------------------------------------------------------------------------
# Obtener estas credenciales desde el dashboard de Supabase:
# Settings > API > Connection string

DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Desarrollo local (usar con docker-compose)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/liderdigital?schema=public