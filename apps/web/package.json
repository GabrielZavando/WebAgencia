{
  "name": "@webastro/web",
  "version": "1.4.2",
  "description": "Landing page con Astro para Agencia Digital Gabriel Zavando",
  "scripts": {
    "dev": "astro dev --open",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:ui": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:validation": "pnpm run test:validation:static && pnpm run test:validation:e2e",
    "test:validation:static": "vitest run --config vitest.config.ts tests/validation/*.test.ts",
    "test:validation:e2e": "playwright test --config playwright-validation.config.ts",
    "link-api-local-dev": "bash scripts/link-api-local-dev.sh"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@webastro/shared-types": "workspace:*",
    "astro": "^7.4.13",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
