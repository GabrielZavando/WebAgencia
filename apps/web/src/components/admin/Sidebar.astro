---
/**
 * Admin sidebar navigation (CMS skeleton).
 * Static .astro markup — the mobile toggle lives in AdminLayout's script.
 */
import { LayoutDashboard, FileText, Tags, FlaskConical } from 'lucide-react';

interface NavLink {
  href: string;
  label: string;
  icon: typeof LayoutDashboard;
  disabled?: boolean;
}

const links: NavLink[] = [
  { href: '/admin', label: 'Panel', icon: LayoutDashboard },
  { href: '/admin/blog/editor-test', label: 'Editor (prueba)', icon: FlaskConical },
  { href: '/admin/blog', label: 'Artículos', icon: FileText, disabled: true },
  { href: '/admin/categories', label: 'Categorías', icon: Tags, disabled: true },
];

// Normalize so "/admin/" (trailing slash in prerender) matches "/admin"
const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
const currentPath = normalize(Astro.url.pathname);
const isActive = (href: string) =>
  currentPath === href || (href !== '/admin' && currentPath.startsWith(`${href}/`));
---

<aside
  id="admin-sidebar"
  class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col border-r border-border bg-surface transition-transform duration-200 lg:translate-x-0"
  aria-label="Navegación del panel de administración"
>
  <div class="flex h-16 items-center gap-2 border-b border-border px-4">
    <span
      class="flex size-8 items-center justify-center rounded-md bg-primary text-sm font-bold text-primary-foreground"
      aria-hidden="true">W</span
    >
    <div class="flex flex-col leading-tight">
      <span class="text-sm font-semibold text-text">WebAstro CMS</span>
      <span class="text-xs text-text-muted">Esqueleto base</span>
    </div>
  </div>

  <nav class="flex-1 space-y-1 overflow-y-auto p-3" aria-label="Secciones del CMS">
    {
      links.map((link) =>
        link.disabled ? (
          <span
            class="flex cursor-not-allowed items-center gap-3 rounded-md px-3 py-2 text-sm text-text-muted"
            aria-disabled="true"
            title="Disponible próximamente"
          >
            <link.icon size={16} aria-hidden="true" />
            {link.label}
            <span class="ml-auto text-[10px] uppercase tracking-wide">Pronto</span>
          </span>
        ) : (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'flex items-center gap-3 rounded-md px-3 py-2 text-sm transition-colors',
              isActive(link.href)
                ? 'bg-primary/10 font-medium text-primary'
                : 'text-text-secondary hover:bg-surface-secondary hover:text-text',
            ]}
          >
            <link.icon size={16} aria-hidden="true" />
            {link.label}
          </a>
        )
      )
    }
  </nav>

  <div class="border-t border-border p-3">
    <p class="text-xs text-text-muted">
      Panel en construcción — sin llamadas a la API todavía.
    </p>
  </div>
</aside>
