---
interface Props {
  code?: string;
  message?: string;
  icon?: string;
  buttonText?: string;
  buttonHref?: string;
}
const {
  code = "404",
  message = "Oops... La página que buscas no existe o ha sido movida.",
  icon = "construction",
  buttonText = "Volver al inicio",
  buttonHref = "/"
} = Astro.props;
---

<section class="flex min-h-[60vh] flex-col items-center justify-center text-center">
  <div class="mb-4 text-4xl">
    <span class="material-symbols-outlined text-inherit">{icon}</span>
  </div>
  <h1 class="mb-2 text-7xl font-bold text-text-muted">{code}</h1>
  <p class="mb-6 text-lg text-text-secondary">{message}</p>
  <a
    href={buttonHref}
    class="inline-block bg-primary px-6 py-3 font-bold text-white no-underline transition-colors hover:bg-secondary"
  >
    {buttonText}
  </a>
</section>
