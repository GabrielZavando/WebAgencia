---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout
  title="Administración | WebAstro"
  description="Panel de administración en construcción"
>
  <section class="flex min-h-[60vh] items-center justify-center bg-surface-secondary dark:bg-body px-4 py-16">
    <div class="max-w-md text-center">
      <span class="material-symbols-outlined text-6xl text-primary mb-4 block" aria-hidden="true">
        construction
      </span>
      <h1 class="text-2xl font-bold text-text mb-2">Panel en construcción</h1>
      <p class="text-text-secondary mb-6">
        Estamos preparando el nuevo panel de administración. Vuelve pronto.
      </p>
      <a href="/" class="btn-cta">Volver al inicio</a>
    </div>
  </section>
</MainLayout>
