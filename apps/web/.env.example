# Variables de entorno para la Landing Page
# Copia este archivo como .env.local y completa los valores

# =============================================================================
# DESARROLLO LOCAL
# =============================================================================
# API local (NestJS corriendo en localhost:3000)
PUBLIC_API_URL=http://localhost:3000/api/v1
PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# URL del sitio local
PUBLIC_SITE_URL=http://localhost:4321

# Cloudflare Turnstile - Key de test (siempre pasa)
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Google Tag Manager (opcional en desarrollo)
PUBLIC_GTM_ID=

# Firebase configuración (requerido para login)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=

# =============================================================================
# PRODUCCIÓN
# =============================================================================
# API de producción (descomentar y completar para producción)
# PUBLIC_API_URL=https://nestjs-api-XXXXXXXXXX.us-central1.run.app
# PUBLIC_API_BASE_URL=https://nestjs-api-XXXXXXXXXX.us-central1.run.app
# PUBLIC_SITE_URL=https://tu-dominio.com
# PUBLIC_TURNSTILE_SITE_KEY=tu_key_real_de_produccion
# PUBLIC_GTM_ID=GTM-XXXXXXXX
