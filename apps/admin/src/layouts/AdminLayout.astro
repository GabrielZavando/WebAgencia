---
/**
 * Admin panel layout (CMS) — autonomous version for apps/admin.
 * Does not wrap MainLayout (public site). Provides its own theme bootstrap
 * (localStorage/system) and minimal <head> without public chrome
 * (no public Header/Footer, GTM or Turnstile).
 */
import Sidebar from '../components/admin/Sidebar.astro';
import Header from '../components/admin/Header.astro';
import SidebarShell from '../components/admin/SidebarShell';
import AuthGuard from '../components/auth/AuthGuard';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  hideHeader?: boolean;
  hideSidebar?: boolean;
}

const {
  title = 'Administración | WebAstro',
  description = 'Panel de administración WebAstro',
  hideHeader = false,
  hideSidebar = false,
} = Astro.props;

// Detectar si la ruta actual es /login para saltar la verificación de sesión
// y evitar un bucle de redirección.
const isLogin = Astro.url.pathname === '/login' || Astro.url.pathname.startsWith('/login/');
---

<!DOCTYPE html>
<html lang="es" data-theme>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Open+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      const setTheme = () => {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme) {
          document.documentElement.setAttribute('data-theme', savedTheme);
        } else {
          const prefersDark = window
            .matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.setAttribute(
            'data-theme',
            prefersDark ? 'dark' : 'light',
          );
        }
      };

      setTheme();
      document.addEventListener('astro:after-swap', setTheme);
    </script>
  </head>
  <body>
    {!hideSidebar && <Sidebar />}

    <SidebarShell client:load hideSidebar={hideSidebar} hideHeader={hideHeader} />

    <div class={`flex min-h-screen flex-col ${isLogin ? '' : 'lg:pl-64'}`}>
      {!hideHeader && <Header />}
      <main id="admin-content" class={isLogin ? 'flex-1' : 'flex-1 p-4 md:p-6'}>
        {!isLogin && <AuthGuard client:load redirectToLogin />}
        <slot />
      </main>
    </div>
  </body>
</html>
