---
import AdminLayout from '../../layouts/AdminLayout.astro';
import TailAdminLogin from '../../components/auth/TailAdminLogin';
import AuthGuard from '../../components/auth/AuthGuard';
import logo from '../../assets/img/logo-medium.png';
import bgImage from '../../assets/img/banner-web.jpg';
---

<AdminLayout
  title="Iniciar sesión | Agencia Digital"
  description="Ingresa a tu panel de administración"
  forcedTheme="dark"
  hideHeader
  hideSidebar
>
  <section class="relative min-h-screen flex flex-col overflow-hidden bg-body !p-0 !m-0 !text-left">
    <!-- Fondo con imagen y overlay tokenizado -->
    <div class="absolute inset-0 z-0">
      <img src={bgImage.src} alt="" class="w-full h-full object-cover blur-[2px]" aria-hidden="true" />
    </div>
    <div class="absolute inset-0 z-[1] bg-gradient-to-br from-[var(--banner-overlay-start)] to-[var(--banner-overlay-end)] pointer-events-none" aria-hidden="true"></div>

    <!-- Logo fixed top-left -->
    <div class="fixed top-4 left-4 sm:top-6 sm:left-6 z-[800]">
      <a href="/" aria-label="Ir al inicio">
        <img src={logo.src} alt="Agencia Digital Logo" width="64" height="64" class="w-12 h-12 sm:w-16 sm:h-16 object-contain logo-animate" />
      </a>
    </div>

    <!-- Contenido centrado: formulario de login -->
    <div data-testid="login-container" class="relative z-[2] min-h-screen flex items-center justify-center px-4 sm:px-6 lg:px-8 bg-cover bg-center">
      <!-- Formulario envuelto en AuthGuard para proteger la ruta -->
      <AuthGuard client:load redirectToLogin={false} redirectToAdmin>
        <TailAdminLogin client:load />
      </AuthGuard>
    </div>
  </section>
</AdminLayout>
