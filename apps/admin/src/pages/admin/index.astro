---
/**
 * Admin panel entry (/admin) — CMS skeleton.
 * Renders the admin shell (sidebar + header + content) with no API calls
 * and no data yet. CRUD views arrive in future changes.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { FlaskConical } from 'lucide-react';
---

<AdminLayout>
  <section class="mx-auto max-w-3xl space-y-4">
    <Card>
      <CardHeader>
        <div class="flex items-center gap-2">
          <CardTitle>CMS de Blog y Categorías</CardTitle>
          <Badge variant="secondary">Esqueleto</Badge>
        </div>
        <CardDescription>
          Base del panel de administración: layout, navegación y editor listo para
          los próximos cambios (CRUD, subida de imágenes y biblioteca de medios).
        </CardDescription>
      </CardHeader>
      <CardContent class="flex flex-col gap-4">
        <p class="text-sm text-text-secondary">
          Este panel todavía no consume datos de la API. Explora la página de
          prueba del editor de texto enriquecido:
        </p>
        <div>
          <Button asChild>
            <a href="/admin/blog/editor-test">
              <FlaskConical aria-hidden="true" />
              Abrir editor de prueba
            </a>
          </Button>
        </div>
      </CardContent>
    </Card>
  </section>
</AdminLayout>
