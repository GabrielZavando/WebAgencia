# Variables de entorno para la aplicación de administración (SSR)
# Copia este archivo como .env.local y completa los valores

# URL de la API (NestJS)
PUBLIC_API_URL=http://localhost:3000/api/v1

# URL del sitio público (para enlaces y redirecciones)
PUBLIC_SITE_URL=http://localhost:4321

# Firebase configuración (requerido para login y token Bearer)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=

# Puerto del servidor Node (adaptador @astrojs/node)
PORT=4322
HOST=0.0.0.0
